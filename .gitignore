# CodeIgniter runtime data (preserve tracked placeholder files)
/writable/cache/
/writable/debugbar/
/writable/logs/*.log
/writable/session/ci_session*
/writable/temp/
/writable/tmp/
/writable/**/*.tmp
/writable/**/*.temp
/writable/**/*.swp
/writable/**/*~

# Large dependency folders: install locally instead of committing them
.pdf
.doc
.docx
.ppt
.pptx

# AI assistants and their local configuration
/.agents/
/.ai/
/.claude/
/.codex/
/.cursor/
/.gemini/
/.github/agents/
/.github/copilot-instructions.md
/.github/instructions/
/.github/prompts/
/.windsurf/

!AGENTS.md
CLAUDE.md
GEMINI.md
*.agent.md
*.prompt.md
.claudeignore
.cursorignore
.cursorrules
