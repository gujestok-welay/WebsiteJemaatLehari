__ci_last_regenerate|i:1793774586;_ci_previous_url|s:51:"http://localhost:8080/index.php/admin/berita?edit=1";admin_id|i:2;admin_name|s:5:"admin";_ci_old_input|a:2:{s:3:"get";a:0:{}s:4:"post";a:7:{s:9:"return_to";s:12:"admin/berita";s:2:"id";s:1:"1";s:5:"title";s:96:"Transformasi Digital Desa: Mahasiswa FIKOM UKIM Jalankan KKN Tematik SMART di Jemaat GPM Leahari";s:4:"slug";s:95:"transformasi-digital-desa-mahasiswa-fikom-ukim-jalankan-kkn-tematik-smart-di-jemaat-gpm-leahari";s:7:"summary";s:282:"Bukan sekadar KKN biasa, sekelompok mahasiswa ilmu komputer dari UKIM ini turun langsung untuk mendigitalisasi Negeri Leahari. Mulai dari pembuatan sistem informasi jemaat, kelas coding gratis bagi remaja, hingga digitalisasi UMKM lokal siap dihadirkan demi membawa perubahan nyata.";s:7:"content";s:1958:"AMBON — Sebanyak sekelompok mahasiswa Kuliah Kerja Nyata Tematik (KKNT) dari Fakultas Ilmu Komputer (FIKOM) Universitas Kristen Indonesia Maluku (UKIM) secara resmi memulai program pengabdian masyarakat di Jemaat GPM Leahari, Kecamatan Leitimur Selatan, Kota Ambon. Kehadiran para mahasiswa ini mengusung misi besar dalam program "UKIM Berdampak Berbasis SMART" untuk mendorong digitalisasi dan modernisasi pelayanan serta ekonomi berbasis komunitas di tingkat jemaat.
Kedatangan tim KKNT FIKOM UKIM ini disambut hangat oleh Pemerintah Negeri Leahari serta pimpinan Majelis Jemaat GPM Leahari. Kolaborasi ini diharapkan dapat menjadi motor penggerak perubahan yang memberikan dampak nyata dan berkelanjutan bagi masyarakat sekitar.
Ketua Kelompok KKNT FIKOM UKIM Leahari menjelaskan bahwa program kerja utama mereka berfokus penuh pada penerapan ilmu teknologi informasi. "Kami membawa tiga pilar program digitalisasi utama, yaitu pembuatan Sistem Informasi Potensi Ekonomi Jemaat, pelatihan literasi digital untuk pengamanan data dan pengelolaan keuangan berbasis aplikasi bagi pelaku UMKM lokal, serta perluasan jangkauan pasar produk unggulan Leahari lewat platform pemasaran digital (e-commerce)," terangnya.
Selain berfokus pada penguatan ekonomi digital warga jemaat, para mahasiswa rumpun ilmu komputer ini juga menginisiasi program edukasi teknologi untuk generasi muda. Mereka menggelar kelas basic coding gratis, pelatihan internet sehat dan aman bagi remaja gereja (AMGPM), serta digitalisasi tata kelola administrasi berbasis web untuk kantor Majelis Jemaat GPM Leahari agar pelayanan data jemaat menjadi lebih terstruktur dan efisien.
Pihak Majelis Jemaat GPM Leahari memberikan apresiasi yang sangat tinggi terhadap inisiatif berbasis teknologi yang dibawa oleh FIKOM UKIM. Program KKNT ini diharapkan mampu menjembatani teori-teori akademik mutakhir dari bangku kuliah dengan realitas serta kebutuhan digitalisasi masyarakat di lapangan.";s:6:"status";s:6:"Terbit";}}__ci_vars|a:2:{s:13:"_ci_old_input";s:3:"old";s:10:"news_error";s:3:"old";}news_error|s:43:"The slug field must contain a unique value.";